{
  "name": "@jk-97/engineering-docs",
  "version": "1.0.0",
  "description": "Project-agnostic engineering documentation standard, CLI, templates, and agent skill",
  "license": "MIT",
  "author": "JK-97",
  "homepage": "https://github.com/JK-97/engineering-docs",
  "bugs": {
    "url": "https://github.com/JK-97/engineering-docs/issues"
  },
  "type": "commonjs",
  "bin": {
    "engineering-docs": "dist/cli.cjs",
    "engdocs": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "PROCESS.md",
    "README.md",
    "LICENSE",
    "framework/templates",
    "framework/skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JK-97/engineering-docs.git"
  },
  "keywords": [
    "documentation",
    "docs",
    "adr",
    "design-docs",
    "cli"
  ],
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.6"
  }
}
